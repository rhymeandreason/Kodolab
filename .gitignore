.DS_Store
resources/
node_modules/
.claude/worktrees/
.env.local
.vercel/

# EVERY RAW DEPOSITION, WHEREVER IT SITS. A .pdb is megabytes of the thing a
# baker READS; what the pages load is the JSON it writes, which is kilobytes.
# Each baker's header carries the curl that fetches its sources back, so a
# clean checkout re-bakes after one download rather than carrying the inputs
# forever. `.pdb1` and friends are biological-assembly files, same deal.
*.pdb
*.pdb[0-9]

# THE ONE EXCEPTION, and it is not about size. napump's OPM copies are a
# second source: they carry the membrane orientation, which is the half of
# that bake nothing here could re-derive from a plain RCSB curl.
!demos/proteins/napump/data/src/*.pdb
!demos/proteins/photosystems/data/src/*-opm.pdb

# Not a .pdb and so not covered above: atp-synthase's sources are 21 MB, three
# of them mmCIF, which is the only format its human structures are published
# in. prep.js's header carries the curl loop.
demos/proteins/atp-synthase/data/src/

# Source PNGs for media/; the committed webps are what pages load.
demos/media/screenshots/
