# Copy to .env.local (gitignored) and fill in the key for whichever provider you use.
# On Vercel these are project environment variables with the same names.

# Which model answers: gemini | anthropic
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where the tutor writes its log: a Neon Postgres connection string, pooled
# (the -pooler host). Unset means logging is simply off, which is what a
# checkout without a database gets. Apply the schema with:
#   node demos/tools/db.js init
DATABASE_URL=

# Optional model overrides. Defaults: gemini-3.7-flash, claude-opus-5
# Uncomment the line, not just the value. Rates for each model are in
# api/_providers/; a model with no rate there is reported as unpriced, not free.
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-sonnet-5

# Legacy testing links: cohort:secret pairs, comma separated.
#   TUTOR_KEYS=bio101-fall:<secret>,openday:<secret>
# Testing links now live in the database, minted in demos/tools/codes.html or
# `node demos/tools/db.js link new <label>`. `db.js link import` copies these
# pairs into it with their secrets unchanged, after which this can go.
#
# The gate is on when this has a pair OR the links table has any row. With
# neither, the tutor and the builder are public and unmetered. When on, it
# applies to localhost too - you will need ?k= like anyone else.
# TUTOR_KEYS=
