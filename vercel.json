{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/ask.js": { "maxDuration": 30 },
    "api/build.js": { "maxDuration": 60 },
    "api/app.js": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/demos/(.*)",
      "headers": [ { "key": "Access-Control-Allow-Origin", "value": "*" } ] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "redirects": [
    { "source": "/(.*).pdb",                   "destination": "/",            "permanent": false },
    { "source": "/viewer-compare",             "destination": "/",            "permanent": false },
    { "source": "/viewer-compare/(.*)",        "destination": "/",            "permanent": false },
    { "source": "/demos/water-lab.html",       "destination": "/water",       "permanent": true },
    { "source": "/demos/molecule-builder.html","destination": "/molecular-bonds", "permanent": true },
    { "source": "/demos/hemoglobin-lab.html",  "destination": "/protein",     "permanent": true },
    { "source": "/demos/glycolysis-lab.html",  "destination": "/glycolysis",  "permanent": true },
    { "source": "/demos/membrane-lab.html",    "destination": "/membrane",    "permanent": true },
